<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View" />

        <variable
            name="item"
            type="com.liziwa.hisense_autorefresh.view.AppListAdapter.ListItem" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:background="@color/white">

        <ImageView
            android:id="@+id/iv_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@{item.icon}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <CheckBox
            android:id="@+id/cb_choice"
            style="@style/NoAnimCheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="@{item.checked}"
            android:clickable="false"
            android:minWidth="48dp"
            android:minHeight="48dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 配置按钮：位于应用名之后、复选框之前，点击弹出独立配置窗口（仅监控模式显示） -->
        <Button
            android:id="@+id/btn_config"
            style="@style/defButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="60dp"
            android:minHeight="40dp"
            android:text="@string/btn_config"
            android:layout_marginEnd="8dp"
            android:visibility="@{item.showConfig ? View.VISIBLE : View.GONE}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toLeftOf="@id/cb_choice"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_title"
            style="@style/defTextStyle"
            android:layout_width="0dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@{item.title}"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/tv_config"
            app:layout_constraintLeft_toRightOf="@id/iv_icon"
            app:layout_constraintRight_toLeftOf="@id/btn_config"
            app:layout_constraintTop_toTopOf="@id/iv_icon"
            app:layout_constraintVertical_chainStyle="packed" />

        <!-- 当前应用独立配置：触发/延迟，仅监控模式显示 -->
        <TextView
            android:id="@+id/tv_config"
            style="@style/defTextStyle"
            android:layout_width="0dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:singleLine="true"
            android:text="@{@string/tv_config_prefix + item.configText}"
            android:textSize="12sp"
            android:visibility="@{item.showConfig ? View.VISIBLE : View.GONE}"
            app:layout_constraintBottom_toBottomOf="@id/iv_icon"
            app:layout_constraintLeft_toRightOf="@id/iv_icon"
            app:layout_constraintRight_toLeftOf="@id/btn_config"
            app:layout_constraintTop_toBottomOf="@id/tv_title" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
