<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 使用 NoActionBar 主题，去掉原生标题栏（太占位置），改为自定义轻量标题栏 -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/black</item>
        <!-- 墨水屏无法显示按下高亮，去掉所有控件的按下水波纹/高亮反馈 -->
        <item name="colorControlHighlight">@android:color/transparent</item>
        <item name="android:colorControlHighlight">@android:color/transparent</item>
        <item name="android:background">@android:color/white</item>
        <item name="checkboxStyle">@style/NoAnimCheckBox</item>
    </style>

    <!-- 自定义标题文字样式（轻量，替代原生 ActionBar） -->
    <style name="CustomTitleTextStyle" parent="defTextStyle">
        <item name="android:textSize">@dimen/title_text_size</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Checkbox tùy biến: ô tick TO (32dp) viền đậm, không hiệu ứng, tối ưu e-ink -->
    <style name="NoAnimCheckBox" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:foreground">@null</item>
        <item name="android:button">@drawable/checkbox_selector</item>
        <!-- gravity center để ô tick 32dp nằm giữa vùng chạm 48dp -->
        <item name="android:gravity">center</item>
    </style>

    <style name="defTextStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/def_text_size</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="areaTitleStyle" parent="defTextStyle">
        <item name="android:textSize">@dimen/area_text_size</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Nút chuẩn: đảm bảo vùng chạm tối thiểu 48dp -->
    <style name="defButtonStyle" parent="defTextStyle">
        <item name="android:background">@drawable/btn_selector</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textSize">@dimen/def_btn_size</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:minWidth">@dimen/touch_min</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Nút trên title bar (Test/Save/Exit): cao 48dp, gọn ngang -->
    <style name="titleButtonStyle" parent="defButtonStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/touch_min</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Nút trạng thái quyền "Not Granted": cao 48dp, rộng đủ chạm -->
    <style name="statusButtonStyle" parent="defButtonStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/touch_min</item>
        <item name="android:minWidth">96dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="areaStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingLeft">@dimen/area_padding</item>
        <item name="android:paddingRight">@dimen/area_padding</item>
        <item name="android:paddingBottom">@dimen/area_padding_bottom</item>
        <item name="android:layout_marginLeft">@dimen/area_margin</item>
        <item name="android:layout_marginRight">@dimen/area_margin</item>
    </style>

    <!-- EditText: thêm minHeight 48dp để dễ bấm focus -->
    <style name="defEditStyle" parent="defTextStyle">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:inputType">number</item>
        <item name="android:background">@null</item>
        <item name="android:singleLine">true</item>
        <item name="android:gravity">center</item>
        <item name="android:imeOptions">actionDone</item>
        <item name="android:drawableBottom">@drawable/line</item>
    </style>
</resources>
